#!/bin/sh
# Refresh the backend's private address across API deployments.
export DNS_RESOLVER="$(awk '/^nameserver / { print $2; exit }' /etc/resolv.conf)"
if [ -z "$DNS_RESOLVER" ]; then
    echo 'No DNS resolver configured' >&2
    exit 1
fi
case "$DNS_RESOLVER" in
    *:*) export DNS_RESOLVER="[$DNS_RESOLVER]" ;;
esac
