# Copy to .env and choose a unique password before starting Docker Compose.
POSTGRES_USER=taxi
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=taxi
POSTGRES_PORT=5432
SERVER_PORT=3000

# Only for docker-compose.maps.yml; choose a separate unique password.
# OSRM/Nominatim service URLs belong in server/.env (see server/MAPS.md).
NOMINATIM_PASSWORD=change-this-nominatim-password
