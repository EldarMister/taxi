EXPO_PUBLIC_API_URL=https://api-production-47be.up.railway.app/api
# Hosted Silero route guidance. Russian prompts fall back to the phone voice
# automatically if the model is temporarily unavailable.
EXPO_PUBLIC_TTS_URL=https://tts-production-9005d.up.railway.app
EXPO_PUBLIC_TTS_SPEAKER=xenia
# The bundled Atlas / Atlas pro map style is used by default. Optionally replace it
# with your own hosted MapLibre style JSON URL.
EXPO_PUBLIC_MAP_STYLE_URL=
# Current OSM vector labels fill house-number and POI gaps without covering the themed map.
EXPO_PUBLIC_OSM_LABELS_TILEJSON_URL=https://vector.openstreetmap.org/shortbread_v1/tilejson.json
# Raster tiles are used only if the vector map fails to load.
EXPO_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# APP_VARIANT defaults to client. Prefer the npm start/build commands instead
# of changing this value by hand.
APP_VARIANT=client
# Existing client builds keep using this legacy variable and project by default.
EXPO_PUBLIC_EAS_PROJECT_ID=a167169e-47e1-4a60-93ec-739f9dd77c10
# Optional explicit IDs for the two independently installable EAS projects.
EXPO_PUBLIC_CLIENT_EAS_PROJECT_ID=
EXPO_PUBLIC_DRIVER_EAS_PROJECT_ID=c9056e00-5a97-482f-b121-75840b31d24e
# Optional paths to the matching Firebase Android files. Local fallbacks are
# mobile/google-services.json and mobile/google-services.driver.json.
CLIENT_GOOGLE_SERVICES_FILE=
DRIVER_GOOGLE_SERVICES_FILE=
# Use production for release builds to disallow Android cleartext HTTP.
APP_ENV=development
