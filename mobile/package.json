{
  "name": "taxi-go-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/run-app-variant.cjs client start --dev-client",
    "start:client": "node scripts/run-app-variant.cjs client start --dev-client",
    "start:driver": "node scripts/run-app-variant.cjs driver start --dev-client",
    "android": "node scripts/run-app-variant.cjs client run:android",
    "android:client": "node scripts/run-app-variant.cjs client run:android",
    "android:driver": "node scripts/run-app-variant.cjs driver run:android",
    "ios": "node scripts/run-app-variant.cjs client run:ios",
    "ios:client": "node scripts/run-app-variant.cjs client run:ios",
    "ios:driver": "node scripts/run-app-variant.cjs driver run:ios",
    "prebuild": "node scripts/run-app-variant.cjs client prebuild",
    "prebuild:client": "node scripts/run-app-variant.cjs client prebuild",
    "prebuild:driver": "node scripts/run-app-variant.cjs driver prebuild",
    "build:android:client:preview": "eas build --platform android --profile preview-client",
    "build:android:driver:preview": "eas build --platform android --profile preview-driver",
    "build:android:client:apk": "eas build --platform android --profile apk-client",
    "build:android:driver:apk": "eas build --platform android --profile apk-driver",
    "build:android:client": "eas build --platform android --profile production-client",
    "build:android:driver": "eas build --platform android --profile production-driver",
    "build:ios:client": "eas build --platform ios --profile production-client",
    "build:ios:driver": "eas build --platform ios --profile production-driver",
    "typecheck": "tsc --noEmit",
    "test:native": "node --test tests/native-lifecycle.test.cjs tests/app-variant.test.cjs tests/location.test.cjs tests/map-selection.test.cjs tests/permission-onboarding.test.cjs tests/push-permissions.test.cjs tests/theme.test.cjs",
    "test:variant": "node --test tests/app-variant.test.cjs",
    "test:api": "node --test scripts/test-api.cjs",
    "test:ui": "node --test scripts/test-ui-contracts.cjs",
    "test:food": "node --test tests/food-cart.test.cjs tests/food-flow.test.cjs tests/food-banners.test.cjs tests/screen-transition.test.cjs",
    "test:auth": "node --test tests/auth-flow.test.cjs",
    "test:booking": "node --test tests/address-format.test.cjs tests/address-search.test.cjs tests/booking-flow.test.cjs tests/booking-panels.test.cjs tests/bottom-panel.test.cjs tests/sheet-stage-transition.test.cjs",
    "test:navigation": "node --test tests/navigation.test.cjs tests/navigation-lifecycle.test.cjs tests/driver-background.test.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@maplibre/maplibre-react-native": "10.4.2",
    "@react-native-community/netinfo": "11.4.1",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-contacts": "~15.0.11",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  }
}
