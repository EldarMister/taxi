{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "local" },
  "build": {
    "preview": { "distribution": "internal", "env": { "APP_ENV": "development" }, "android": { "buildType": "apk" } },
    "apk": { "distribution": "internal", "environment": "production", "env": { "APP_ENV": "production" }, "android": { "buildType": "apk" } },
    "production": { "environment": "production", "env": { "APP_ENV": "production" }, "android": { "buildType": "app-bundle" } }
  }
}
