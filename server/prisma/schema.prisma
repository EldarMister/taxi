generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  CLIENT
  DRIVER
  ADMIN
}
enum OrderStatus {
  SEARCHING
  ASSIGNED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_DRIVER
}
enum LedgerKind {
  TOPUP
  COMMISSION
}
model User {
  id String @id @default(uuid()) @db.Uuid
  phone String @unique
  name String @default("")
  avatarData Bytes?
  avatarMime String?
  avatarUpdatedAt DateTime?
  role Role @default(CLIENT)
  notifications Boolean @default(true)
  language String @default("ru")
  createdAt DateTime @default(now())
  driverProfile DriverProfile?
  sessions RefreshSession[]
  quotes Quote[]
  clientOrders Order[] @relation("ClientOrders")
  driverOrders Order[] @relation("DriverOrders")
  sentMessages Message[]
  pushTokens PushToken[]
  foodOrders FoodOrder[]
  adminCredential AdminCredential?
}
model DriverProfile {
  userId String @id @db.Uuid
  user User @relation(fields:[userId],references:[id])
  verified Boolean @default(false)
  online Boolean @default(false)
  deposit Int @default(0)
  locationLatitude Float?
  locationLongitude Float?
  locationAccuracyM Float?
  locationMeasuredAt DateTime?
  vehicle Vehicle?
  ledger LedgerEntry[]
  offers OrderOffer[]
}
model Vehicle {
  id String @id @default(uuid()) @db.Uuid
  driverId String @unique @db.Uuid
  driver DriverProfile @relation(fields:[driverId],references:[userId])
  make String
  color String
  plate String @unique
}
model Tariff {
  id String @id
  name String
  description String
  basePrice Int
  pricePerKm Int
  pricePerMinute Int
  minimumPrice Int
  commissionBps Int
  active Boolean @default(true)
  quotes Quote[]
}
model Quote {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id])
  tariffId String
  tariff Tariff @relation(fields:[tariffId],references:[id])
  pickup Json
  dropoff Json
  geometry Json
  distanceMeters Int
  durationSeconds Int
  price Int
  commission Int
  routeProvider String
  expiresAt DateTime
  createdAt DateTime @default(now())
  order Order?
  @@index([userId,createdAt])
}
model Order {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client User @relation("ClientOrders",fields:[clientId],references:[id])
  driverId String? @db.Uuid
  driver User? @relation("DriverOrders",fields:[driverId],references:[id])
  quoteId String @unique @db.Uuid
  quote Quote @relation(fields:[quoteId],references:[id])
  idempotencyKey String
  status OrderStatus @default(SEARCHING)
  driverLocation Json?
  pickup Json
  dropoff Json
  geometry Json
  distanceMeters Int
  durationSeconds Int
  price Int
  commission Int
  comment String @default("")
  passengerName String?
  passengerPhone String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  searchExpiresAt DateTime
  completedAt DateTime?
  history StatusHistory[]
  messages Message[]
  rating Rating?
  clientRating ClientRating?
  ledger LedgerEntry[]
  offers OrderOffer[]
  @@unique([clientId,idempotencyKey])
  @@index([status,searchExpiresAt])
  @@index([driverId,createdAt])
  @@index([clientId,createdAt])
}
model StatusHistory {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields:[orderId],references:[id])
  status OrderStatus
  actorId String? @db.Uuid
  reason String?
  createdAt DateTime @default(now())
}
model OrderOffer {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields:[orderId],references:[id])
  driverId String @db.Uuid
  driver DriverProfile @relation(fields:[driverId],references:[userId])
  skipped Boolean @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@unique([orderId,driverId])
  @@index([driverId,skipped])
  @@index([orderId,skipped,expiresAt])
}
model Message {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields:[orderId],references:[id])
  senderId String @db.Uuid
  sender User @relation(fields:[senderId],references:[id])
  clientMessageId String
  text String
  createdAt DateTime @default(now())
  @@unique([senderId,clientMessageId])
  @@index([orderId,createdAt])
}
model Rating {
  id String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  order Order @relation(fields:[orderId],references:[id])
  score Int
  comment String @default("")
  createdAt DateTime @default(now())
}
model ClientRating {
  id String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  order Order @relation(fields:[orderId],references:[id])
  score Int
  comment String @default("")
  createdAt DateTime @default(now())
}
model LedgerEntry {
  id String @id @default(uuid()) @db.Uuid
  driverId String @db.Uuid
  driver DriverProfile @relation(fields:[driverId],references:[userId])
  orderId String? @unique @db.Uuid
  order Order? @relation(fields:[orderId],references:[id])
  kind LedgerKind
  amount Int
  balanceAfter Int
  idempotencyKey String @unique
  actorId String? @db.Uuid
  note String
  createdAt DateTime @default(now())
  @@index([driverId,createdAt])
}
model RefreshSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id])
  tokenHash String @unique
  familyId String @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  adminAuthenticated Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([userId,familyId])
}

model AdminCredential {
  userId String @id @db.Uuid
  user User @relation(fields:[userId],references:[id])
  username String @unique
  passwordHash String
  disabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminAudit {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  action String
  entity String
  entityId String
  details Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([entity,entityId])
}

model Banner {
  id String @id @default(uuid()) @db.Uuid
  title String
  subtitle String @default("")
  imageUrl String?
  imageKey String?
  actionType String @default("NONE")
  restaurantId String?
  sortOrder Int @default(0)
  active Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active,sortOrder])
}

model MediaAsset {
  id String @id @default(uuid()) @db.Uuid
  data Bytes
  mime String
  width Int
  height Int
  createdAt DateTime @default(now())
}
model SmsChallenge {
  phone String @id
  codeHash String
  attempts Int @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  requestedAt DateTime @default(now())
}
model RateLimit {
  key String @id
  count Int
  expiresAt DateTime
}
model PushToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id])
  token String @unique
  platform String
  updatedAt DateTime @updatedAt
}
model PushJob {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  event String
  orderId String @db.Uuid
  attempts Int @default(0)
  availableAt DateTime @default(now())
  sentAt DateTime?
  createdAt DateTime @default(now())
  @@index([sentAt,availableAt])
}

enum FoodOrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  READY
  DELIVERING
  COMPLETED
  CANCELLED
}
enum FoodFulfillment {
  DELIVERY
  PICKUP
}
enum FoodPaymentMethod {
  CASH
  CARD
  ONLINE
}
model FoodRestaurant {
  id String @id
  catalog Json
  active Boolean @default(false)
  isDemo Boolean @default(false)
  sortOrder Int @default(0)
  updatedAt DateTime @updatedAt
  orders FoodOrder[]
}
model FoodOrder {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client User @relation(fields:[clientId],references:[id])
  restaurantId String
  restaurant FoodRestaurant @relation(fields:[restaurantId],references:[id])
  restaurantSnapshot Json
  requestId String
  requestHash String
  items Json
  subtotal Int
  deliveryFee Int
  total Int
  fulfillment FoodFulfillment
  address String
  comment String @default("")
  paymentMethod FoodPaymentMethod
  status FoodOrderStatus @default(PLACED)
  isDemo Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  history FoodStatusHistory[]
  @@unique([clientId,requestId])
  @@index([clientId,createdAt])
  @@index([status,createdAt])
}
model FoodStatusHistory {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order FoodOrder @relation(fields:[orderId],references:[id])
  status FoodOrderStatus
  actorId String @db.Uuid
  reason String?
  createdAt DateTime @default(now())
  @@index([orderId,createdAt])
}
