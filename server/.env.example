NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://taxi:taxi_dev_password@localhost:5432/taxi?schema=public
# Generate separate random secrets of at least 32 characters; never commit .env.
JWT_SECRET=replace-with-random-at-least-32-characters
OTP_SECRET=replace-with-another-random-32-character-secret
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
DEV_AUTH_ENABLED=true
DEV_OTP_CODE=123456
# Outside NODE_ENV=development: set DEV_AUTH_ENABLED=false and configure real providers.
SMS_PROVIDER=development
# SMS_PROVIDER=http requires an HTTPS gateway accepting {phone,message}, 2xx response.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
ROUTING_PROVIDER=approximation
# The free mobile MapKit key draws the A-to-B route in the app. Optional
# ROUTING_PROVIDER=yandex uses a separate paid server Router API key for exact fare distance.
YANDEX_ROUTER_API_KEY=
# Optional server-side /places/search and /places/reverse; native MapKit Search has its own key.
YANDEX_GEOCODER_API_KEY=
PUSH_PROVIDER=development
# PUSH_PROVIDER=expo for Expo push tokens; enable enhanced push security in Expo.
EXPO_ACCESS_TOKEN=
# PUSH_PROVIDER=firebase: absolute service-account JSON path, kept outside source tree.
GOOGLE_APPLICATION_CREDENTIALS=
SEARCH_TIMEOUT_SECONDS=120
MIN_DRIVER_DEPOSIT=50
SUPPORT_PHONE=+996700000000
