NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://taxi:taxi_dev_password@localhost:5432/taxi?schema=public
# Generate separate random secrets of at least 32 characters; never commit .env.
JWT_SECRET=replace-with-random-at-least-32-characters
OTP_SECRET=replace-with-another-random-32-character-secret
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
DEV_AUTH_ENABLED=true
DEV_OTP_CODE=123456
# Outside NODE_ENV=development: set DEV_AUTH_ENABLED=false and configure real providers.
SMS_PROVIDER=development
# SMS_PROVIDER=http requires an HTTPS gateway accepting {phone,message}, 2xx response.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
ROUTING_PROVIDER=osrm
# Development demo only. Production requires a dedicated OSRM service.
# With docker-compose.maps.yml use http://127.0.0.1:5000 for an API on the host.
OSRM_BASE_URL=https://router.project-osrm.org
# Set to your own Nominatim or a compatible provider, e.g. http://127.0.0.1:8088.
# Public nominatim.openstreetmap.org is not supported for this taxi app.
# Empty in development => address endpoints return 503; required in production.
NOMINATIM_BASE_URL=
NOMINATIM_USER_AGENT=TaxiGO/1.0 (development)
NOMINATIM_MIN_INTERVAL_MS=1000
# Dedicated typo-tolerant autocomplete; reverse geocoding stays on Nominatim.
PHOTON_BASE_URL=
PUSH_PROVIDER=development
# PUSH_PROVIDER=expo for Expo push tokens. EXPO_ACCESS_TOKEN is only needed
# when enhanced push security is enabled for the Expo project.
EXPO_ACCESS_TOKEN=
# PUSH_PROVIDER=firebase: absolute service-account JSON path, kept outside source tree.
GOOGLE_APPLICATION_CREDENTIALS=
MIN_DRIVER_DEPOSIT=50
SUPPORT_PHONE=+996700000000
