{
  "name": "taxi-server", "version": "1.0.0", "private": true,
  "engines": {"node": ">=20.19"},
  "scripts": {
    "dev": "npm run build && node --watch dist/src/main.js", "watch": "tsc -p tsconfig.json --watch", "build": "prisma generate && tsc -p tsconfig.json", "start": "node dist/src/main.js", "start:migrate": "prisma migrate deploy && node dist/src/main.js",
    "db:generate": "prisma generate", "db:migrate": "prisma migrate deploy", "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test test/domain.test.ts", "test:integration": "tsx --test --test-concurrency=1 test/integration.test.ts"
  },
  "prisma": {"seed": "tsx prisma/seed.ts"},
  "dependencies": {
    "@nestjs/common": "^11.1.6", "@nestjs/core": "^11.1.6", "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6", "@nestjs/platform-socket.io": "^11.1.6", "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.0", "@nestjs/websockets": "^11.1.6", "@prisma/client": "6.19.0", "prisma": "6.19.0",
    "class-transformer": "^0.5.1", "class-validator": "^0.14.2", "dotenv": "^17.2.1", "firebase-admin": "^13.5.0",
    "helmet": "^8.1.0", "reflect-metadata": "^0.2.2", "rxjs": "^7.8.2", "socket.io": "^4.8.1"
  },
  "devDependencies": {"@nestjs/testing":"^11.1.6", "@types/express": "^5.0.3", "@types/node": "^24.3.0", "@types/supertest":"^6.0.3", "socket.io-client":"^4.8.1", "supertest":"^7.1.4", "tsx": "^4.20.5", "typescript": "^5.9.2"}
}
